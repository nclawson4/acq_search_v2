# Copy to .env and populate. .env is gitignored. Do NOT copy values from v1.

# --- Deepgram (audio transcription + diarization) ---
# Required for transcribe_all.py.
DEEPGRAM_API_KEY=

# --- OpenAI (optional) ---
# Reserved for later claim-extraction / message-similarity work. Not used by
# the current scripts in scripts/.
OPENAI_API_KEY=

# --- Reference voice clips for speaker identification ---
# Absolute paths to short solo clips of each speaker. identify_speakers.py
# builds a Resemblyzer centroid from each.
ALEX_REFERENCE_AUDIO=
LEILA_REFERENCE_AUDIO=
SHARRAN_REFERENCE_AUDIO=

# --- Guardrails: rate limit + daily cost cap (Upstash Redis) -----------------
# Required to ARM the guardrails. Set on BOTH the Vercel project (the proxy
# enforces the limit + cap) and the Modal backend (it accounts spend). KV_* are
# accepted as aliases. If UNSET, the guardrails are disabled (fail-open) and the
# demo still works. Same instance is shared via the `v2:rl:*` / `v2:spend:*` keys.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Per-IP rate limit (default: 10 requests / "5 m"). Enforced at the proxy.
SEARCH_RATE_LIMIT=10
SEARCH_RATE_WINDOW=5 m

# Hard daily spend cap in USD across all visitors (default 5). The proxy refuses
# new searches with HTTP 402 once the day's measured LLM cost reaches this.
MAX_DAILY_COST_USD=5

# --- CORS (Modal backend) ----------------------------------------------------
# Comma-separated allow-list of browser origins permitted to call the backend
# directly. Defaults to the prod Vercel domain + http://localhost:3000 when
# unset. Set ALLOWED_ORIGIN_REGEX (e.g. https://.*\.vercel\.app) to also allow
# Vercel preview deployments.
ALLOWED_ORIGINS=
ALLOWED_ORIGIN_REGEX=
